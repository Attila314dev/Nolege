# The only required setting for live AI. Leave empty to play from the question bank.
# Set this directly in Render > Environment for the hosted app.
GROQ_API_KEY=

# Optional second free provider; no need to configure both.
OPENROUTER_API_KEY=

# Optional explicit OpenRouter model. The default route uses free models.
OPENROUTER_MODEL=openrouter/free

# Hosted: separate Render Key Value; local: atomic JSON persistence below.
REDIS_URL=
QUESTION_POOL_FILE=./data/general-pool.json
