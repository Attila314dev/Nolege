# Optional live AI. Keep the key server-side in Render > Environment.
# Gemini is used first; without any provider key, the saved bank remains playable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback providers; only configure the ones you want to use.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional explicit OpenRouter model. The default route uses free models.
OPENROUTER_MODEL=openrouter/free

# Hosted: separate Render Key Value; local: atomic JSON persistence below.
REDIS_URL=
QUESTION_POOL_FILE=./data/general-pool.json

# Private admin. Generate random access with: node tools/create_admin_access.mjs
# Copy only renderEnv from the resulting PRIVATE file to Render Environment.
ADMIN_OWNER_USERNAME=attila
ADMIN_OWNER_PASSWORD_HASH=
ADMIN_ASSISTANT_TOKEN_HASH=
ADMIN_SESSION_SECRET=

# App-owned GitHub token; independent of the ChatGPT GitHub connector.
# Fine-grained, only this repository, Contents: Read and write.
GITHUB_BANK_TOKEN=
GITHUB_BANK_REPO=Attila314dev/Nolege
# Local-only catalog storage. Render always uses GitHub storage.
CATALOG_FILE=./bank/catalog.json
